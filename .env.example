# arriero runtime configuration.
# Copy to .env (gitignored) and fill in the values you need.
# Real environment variables set at launch take precedence over this file.
# Legacy LLAMA_MANAGER_* names in .env are renamed to ARRIERO_* in place on the
# next start; legacy names coming from the real launch environment are read as
# a deprecated fallback and warn once.

# --- Network ---
# Bind address. 127.0.0.1 = local only; 0.0.0.0 = reachable over the LAN.
# When exposing over the LAN, set an admin password below.
ARRIERO_HOST=127.0.0.1
ARRIERO_PORT=8787

# --- Local layout ---
# Every path below defaults to a directory under ARRIERO_HOME, which is the
# repository root unless set. Set only the ones you want to relocate.
# ARRIERO_HOME=/srv/arriero

# Portable settings live here. This directory can be cloned and managed as a
# standalone Git repository from the Configuration Git page.
# Defaults to <data>/config.
# ARRIERO_CONFIG_DIR=/srv/arriero-config

# Database and per-request artifacts. Defaults to <home>/data.
# ARRIERO_DATA_DIR=/srv/arriero-data

# Runtime artifacts stay outside the configuration repository.
# Defaults to <home>/runtime.
# ARRIERO_RUNTIME_DIR=/srv/arriero-runtime

# These all default to a subdirectory of <runtime>.
# ARRIERO_LOGS_DIR=/srv/arriero-runtime/logs
# ARRIERO_BUILDS_DIR=/srv/arriero-runtime/builds
# ARRIERO_ENVS_DIR=/srv/arriero-runtime/envs
# ARRIERO_MODELS_DIR=/srv/arriero-runtime/models
# ARRIERO_SLOTS_DIR=/srv/arriero-runtime/slots
# ARRIERO_VLLM_CACHE_DIR=/srv/arriero-runtime/cache/vllm
# ARRIERO_WEBAPPS_DIR=/srv/arriero-runtime/webapps

# Managed inference source checkouts live under <runtime>/sources by default.
# ARRIERO_SOURCES_DIR=/srv/arriero-sources
# ARRIERO_PYTHON_DIR=/srv/arriero-python
# ARRIERO_UV_CACHE_DIR=/srv/arriero-uv-cache

# --- Manager logging ---
# pino level for the manager's own log: trace/debug/info/warn/error/fatal/silent.
# LOG_LEVEL=info

# --- Managed process logs ---
# Routine /health, /props, /slots and /v1/models probe lines are stripped from
# the filtered log (the raw log always keeps everything). Set to false to keep
# them.
# ARRIERO_FILTER_PROBE_LOGS=true

# --- NUMA (docs/NUMA_PINNING.md) ---
# cpuset cgroup directory for bind-mode instances. Derived from the manager's
# own cgroup when unset; set it only if that derivation is wrong for your setup.
# ARRIERO_NUMA_CGROUP_ROOT=/sys/fs/cgroup/.../arriero-instances

# --- API proxy ---
# How often idle maintenance re-plans unloads of idle targets (default 30 s).
# ARRIERO_PROXY_IDLE_INTERVAL_MS=30000

# --- Memory assessment ---
# How often the background pass auto-binds analytical estimates and captures
# measured baselines for unassessed/stale instances (default 60 s; <=0 disables).
# ARRIERO_MEMORY_ASSESS_INTERVAL_MS=60000

# --- Admin auth ---
# Admin routes (/api/*) are open when no password is set below.
# Recommended: generate a hash + secret with `pnpm auth:hash 'your-password'`
# and paste its two lines here (the pair below mirrors that output).
ARRIERO_ADMIN_PASSWORD_HASH=
ARRIERO_AUTH_SECRET=

# Alternative for dev: a plaintext password instead of the hash above.
# If set, AUTH_SECRET defaults to this value when left empty.
ARRIERO_ADMIN_PASSWORD=

# Set to true only when serving over HTTPS, otherwise the browser drops the cookie.
# ARRIERO_SECURE_COOKIE=false

# Session lifetime in seconds (default 12h).
# ARRIERO_SESSION_TTL_SECONDS=43200

# Provider API keys referenced by apiKeyEnvVar in tracked endpoint settings can
# be supplied here. Use provider-specific names that do not start with
# ARRIERO_, for example:
# OPENROUTER_API_KEY=

# --- Shutdown ---
# By default managed llama-server processes survive a manager shutdown and are
# re-adopted on the next start (models stay in VRAM across manager restarts).
# Set to true to stop all managed processes when the manager exits.
# ARRIERO_STOP_MANAGED_ON_EXIT=false

# How long shutdown waits for supervised children before giving up (default 10 s).
# ARRIERO_SHUTDOWN_TIMEOUT_MS=10000

# --- Stream resume across restarts (docs/STREAM_RESUME.md) ---
# How long adopted stream sessions wait for a client retry after a restart
# before being cancelled upstream (default 3 min; llama.cpp keeps completed
# sessions for 5 min).
# ARRIERO_PROXY_RESUME_CLAIM_WINDOW_MS=180000
# How long the self-update restart waits for non-resumable in-flight requests
# to finish before restarting (default 10 s).
# ARRIERO_UPDATE_DRAIN_TIMEOUT_MS=10000
